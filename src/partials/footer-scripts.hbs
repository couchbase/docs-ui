{{#if (and page.component (eq (nav-mode) 'client'))}}
{{#with (nav-group-for-page (nav-groups))}}
{{!-- could instead pass this path to site.js and have it load the navigation data itself --}}
<script src="{{{@root.uiRootPath}}}/js/site-navigation-data.js"></script>
<script id="page-navigation-group" type="application/json">
{{{stringify this}}}
</script>
{{/with}}
{{/if}}
<template id="run-code-panel">
{{> terminal}}
</template>

{{#if env.ALGOLIA_API_KEY}}
{{!-- the real, Antora-driven catalog of navGroups/components/colors that drives the search facet tree --}}
<script id="search-catalog" type="application/json">
{{{stringify (search-catalog (nav-groups))}}}
</script>
{{!-- vendor/algolia.js pulls in react (an unused side effect of instantsearch.js re-exporting every widget) whose dev build reads process.env.NODE_ENV unguarded; this repo's vendor bundles have no Node-global shims, so give it one before it loads --}}
<script>window.process = window.process || { env: { NODE_ENV: 'production' } }</script>
{{!-- must load synchronously, before site.js (which contains 13-docsearch.js), so window.algoliasearch/window.instantsearch are set before it runs --}}
<script src="{{{uiRootPath}}}/js/vendor/algolia.js"></script>
{{/if}}
{{#unless page.attributes.disable-chatbot}}
{{!-- must load synchronously, before site.js (which contains 12-chatbox-render.js),
     so window.marked/window.DOMPurify are set before it runs --}}
<script src="{{{uiRootPath}}}/js/vendor/chatbot.js"></script>
{{/unless}}
<script id="site-script" src="{{{uiRootPath}}}/js/site.js"></script>
<script async src="{{{uiRootPath}}}/js/vendor/tabs.js" data-sync-storage-key="preferred-tab"></script>
{{#with page.attributes.content-scripts}}
{{{this}}}
{{/with}}
<script defer src="{{#unless preview}}{{{uiRootPath}}}/js/vendor/{{/unless}}fontawesome-icon-defs.js"></script>
<script defer src="{{{uiRootPath}}}/js/vendor/fontawesome.js" data-search-pseudo-elements="true"></script>
<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
{{#with (resolvePage page.relativeSrcPath model=false)}}
    {{#unless (eq asciidoc.attributes.stem undefined)}}
<script type="text/x-mathjax-config">
MathJax.Hub.Config({
  messageStyle: "none",
  tex2jax: { inlineMath: [["\\(", "\\)"]], displayMath: [["\\[", "\\]"]], ignoreClass: "nostem|nolatexmath" },
  asciimath2jax: { delimiters: [["\\$", "\\$"]], ignoreClass: "nostem|noasciimath" },
  TeX: { equationNumbers: { autoNumber: "none" } }
})
MathJax.Hub.Register.StartupHook("AsciiMath Jax Ready", function () {
  MathJax.InputJax.AsciiMath.postfilterHooks.Add(function (data, node) {
    if ((node = data.script.parentNode) && (node = node.parentNode) && node.classList.contains("stemblock")) {
      data.math.root.display = "block"
    }
    return data
  })
})
</script>
<script async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.9/MathJax.js?config=TeX-MML-AM_HTMLorMML"></script>
    {{/unless}}
{{/with}}
{{#if (eq env.SHOW_FEEDBACK_BUTTON 'true')}}
<script async id="feedback-script" src="{{{uiRootPath}}}/js/vendor/feedback.js?v=1" data-collector-id="{{#if env.JIRA_COLLECTOR_ID}}{{env.JIRA_COLLECTOR_ID}}{{else}}709818cb{{/if}}"></script>
{{/if}}
