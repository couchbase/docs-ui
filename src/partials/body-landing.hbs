<div class="body container">
{{#if (eq nav 'full')}}
{{> nav}}
{{> toc}}
{{else if (eq nav 'tutorials-filter')}}
{{> tutorials-filter}}
{{else if (eq nav 'sidebar')}}
{{#if (eq (nav-mode) 'client')}}
{{#with (nav-group-for-page (nav-groups))}}
{{#if ./components.length}}
{{> nav page=@root.page}}
{{/if}}
{{/with}}
{{/if}}
{{/if}}
<main class="{{or mainClass 'article'}}" data-ceiling="topbar">
{{> llms-guidance}}
{{> watermark}}
{{> view-latest-banner}}
<article class="doc landing-page-doc{{#if articleClass}} {{articleClass}}{{/if}}">
{{#if capellaImages}}
<img class="opening-image" src="{{{uiRootPath}}}/img/stars.svg" alt="" aria-hidden="true" role="presentation" />
{{/if}}
{{{page.contents}}}
{{#if capellaImages}}
<img class="ending-image" src="{{{uiRootPath}}}/img/lineplus.svg" alt="" aria-hidden="true" role="presentation" />
{{/if}}
</article>
</main>
</div>
