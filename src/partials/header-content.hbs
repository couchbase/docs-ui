<header class="header fixed-top">
  <div class="header-top-row">
      <div class="container">
          <nav class="navbar navbar-expand-md flex-nowrap justify-content-between navbar-new-top">
              <ul class="navbar-brand-list">
                <li class="brand-logo">
                  <a class="navbar-brand" href="https://www.couchbase.com">
                    <img src="{{{uiRootPath}}}/img/couchbase-logo.svg" alt="Couchbase" />
                  </a>
                </li>
                <li>
                  <a class="navbar-brand cb-documentation"
                      href="{{#if (and site.url site.homeUrl)}}{{{site.url}}}{{{site.homeUrl}}}{{else}}{{{siteRootPath}}}{{/if}}">
                    <img src="{{{uiRootPath}}}/img/cb-documentation.svg" alt="Couchbase Documentation" class="cb-docs" />
                    <img src="{{{uiRootPath}}}/img/cb-docs-hover.svg" alt="Couchbase Documentation" class="hide cb-hover-docs" />
                  </a>
                </li>
              </ul>
              {{! <ul class="nav navbar-nav mr-auto"></ul> }}
              <button class="navbar-burger" data-target="topbar-menu">
                <span></span>
                <span></span>
                <span></span>
              </button>

          </nav>
      </div>
  </div>
  {{! End primary header }}
  {{! Start secondary header }}
  <div class="header-bottom-row" id="topbar-menu">
    <div class="container">
        <nav  class="navbar navbar-new-bottom {{page.attributes.capella-type}}">

              <div class="navbar-collapse collapse" id="navbar2">
                <ul class="navbar-nav w-100 justify-content-start">
                  {{#with (nav-groups)}}

                  <li class="nav-item {{#if (nav-group-selected "home")}}nav-item-selected{{/if}}"">
                    <a href="{{#if (and @root.site.url @root.site.homeUrl)}}{{@root.site.url}}{{@root.site.homeUrl}}{{else}}{{siteRootPath}}{{/if}}" class="nav-link">
                      <i class="fas fa-home"></i>
                    </a>
                  </li>
                  {{#each this}}
                  {{#if (or ./url ./subGroups)}}
                  <li class="nav-item {{#if (nav-group-selected this)}}nav-item-selected{{/if}}">
                    <a class="nav-link" href="{{relativize ./url}}">
                      {{{./title}}}
                      
                      {{#if (eq ./title 'Tutorials')}}
                      <span class="arrow">
                        <i class="fas fa-arrow-right"></i>
                      </span>
                      {{/if}}
                    </a>
                    {{#with ./subGroups}}
                    <ul class="nav-submenu">
                      {{#each this}}
                      <li class="nav-item nav-submenu-item {{#if (nav-group-selected this)}}nav-submenu-item-selected{{/if}}">
                        <a class="nav-link nav-submenu-link" href="{{relativize ./url}}">
                          {{{./title}}}
                        </a>
                      </li>
                      {{/each}}
                    </ul>
                    {{/with}}
                  </li>
                  {{/if}}
                  {{/each}}
                  {{/with}}
                </ul>
              </div>
              <div class="primary-action">
                {{#if (and env.ALGOLIA_API_KEY (ne bodyTemplate "body-search-page"))}}
                <div class="navbar-item search" id="search">
                  {{> search-panel}}
                  {{#if env.SEARCH_PAGE_URL}}
                  <a class="search-mobile-cta" href="{{{siteRootPath}}}{{{env.SEARCH_PAGE_URL}}}">
                    <i class="fas fa-search"></i> Search
                  </a>
                  {{/if}}
                </div>
                {{/if}}
                {{#unless page.attributes.disable-chatbot}}
                <button type="button" id="ask-ai-button" class="btn btn-ask-ai">
                  <i class="fas fa-sparkles" aria-hidden="true"></i>
                  Ask AI
                </button>
                {{/unless}}
                <a class="btn btn-primary btn-grey-reverse header-cta" onclick="(window.dataLayer=window.dataLayer||[]).push({'event':'customEvent', 'category':'CTA', 'action':'Button Click',  'label':'Download'});" href="https://www.couchbase.com/downloads">
                  <span class="btn-label">Downloads</span>
                  <i class="far fa-arrow-to-bottom fa-fw"></i>
                </a>
                <a href="https://cloud.couchbase.com/sign-up" class="btn btn-primary header-cta" onclick="(window.dataLayer=window.dataLayer||[]).push({'event':'customEvent', 'category':'CTA', 'action':'Button Click',  'label':'Free Trial'});" >
                  <span class="btn-label">Try Free</span>
                  <i class="far fa-cloud fa-fw"></i>
                </a>
              </div>

        </nav>
    </div>
   </div>
</header>
